  "rateOn": [
    { "date": "2026-03-02", "rate": 40, "why": "its own rate" },
    { "date": "2026-03-03", "rate": 40, "why": "the closest earlier rate" },
    { "date": "2026-03-04", "rate": 42.5, "why": "its own rate" },
    { "date": "2026-03-08", "rate": 42.5, "why": "a weekend uses the last business day" },
    { "date": "2026-03-09", "rate": 39.123, "why": "its own rate" },
    { "date": "2027-01-01", "rate": 39.123, "why": "after every rate: the latest" },
    { "date": "2026-03-01", "rate": 40, "why": "before every rate: the earliest, as an estimate" },
    { "date": "2020-01-01", "rate": 40, "why": "long before every rate: still the earliest" }
  ],
  "conversions": [
    {
      "cents": 100000,
      "from": "USD",
      "to": "UYU",
      "date": "2026-03-02",
      "expected": 4000000,
