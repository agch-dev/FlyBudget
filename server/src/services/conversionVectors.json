    },
    {
      "cents": 100000,
      "from": "UYU",
      "to": "USD",
      "date": "2026-03-02",
      "expected": 2500,
      "why": "$1,000 at 40"
    },
    {
      "cents": 12345,
      "from": "USD",
      "to": "UYU",
      "date": "2026-03-04",
      "expected": 524663,
      "why": "524,662.5 rounds half away from zero"
    },
    {
      "cents": -12345,
      "from": "USD",
      "to": "UYU",
