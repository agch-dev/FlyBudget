      "expected": -524663,
      "why": "money out mirrors money in"
    },
    {
      "cents": 3,
      "from": "USD",
      "to": "UYU",
      "date": "2026-03-05",
      "expected": 128,
      "why": "127.5 rounds up, at the carried rate"
    },
    {
      "cents": -3,
      "from": "USD",
      "to": "UYU",
      "date": "2026-03-05",
      "expected": -128,
      "why": "-127.5 rounds away from zero"
    },
    {
      "cents": 20,
      "from": "UYU",
      "to": "USD",
      "date": "2026-03-02",
      "expected": 1,
      "why": "0.5 rounds up"
    },
    {
      "cents": -20,
      "from": "UYU",
      "to": "USD",
      "date": "2026-03-02",
      "expected": -1,
      "why": "-0.5 rounds away from zero"
    },
    {
      "cents": 19,
      "from": "UYU",
      "to": "USD",
      "date": "2026-03-02",
      "expected": 0,
      "why": "0.475 rounds to nothing"
    },
    {
      "cents": -1,
      "from": "UYU",
      "to": "USD",
      "date": "2026-03-02",
      "expected": 0,
      "why": "never negative zero"
    },
    {
      "cents": 100,
      "from": "USD",
      "to": "UYU",
      "date": "2026-03-09",
      "expected": 3912,
      "why": "3,912.3 rounds down"
    },
    {
      "cents": 1000,
      "from": "USD",
      "to": "UYU",
      "date": "2026-03-09",
      "expected": 39123,
      "why": "three decimals of rate"
    },
    {
      "cents": 100000,
      "from": "UYU",
      "to": "USD",
      "date": "2026-03-09",
      "expected": 2556,
      "why": "2,556.04 rounds down"
    },
    {
      "cents": 1000,
      "from": "USD",
      "to": "UYU",
      "date": "2020-01-01",
      "expected": 40000,
      "why": "before every rate: the earliest one"
