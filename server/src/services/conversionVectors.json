      "to": "UYU",
      "date": "2026-03-04",
      "expected": 5000,
      "why": "same currency: unchanged"
    },
    {
      "cents": -777,
      "from": "USD",
      "to": "USD",
      "date": "2019-01-01",
      "expected": -777,
      "why": "same currency: unchanged, whatever the date"
    }
